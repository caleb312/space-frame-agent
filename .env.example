# 配置说明模板；程序读取操作系统环境变量，不自动读取此文件。
# 模型名称请使用你账号当前可调用且支持工具调用的型号。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION=0
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_TOKENS=32768
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_EXPLAIN_TIMEOUT=60

QWEN_API_KEY=
QWEN_MODEL=
# 按账号地区填写地址；这里是北京区域常用兼容接口。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION=0

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION=0
